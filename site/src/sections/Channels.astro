---
import Chapter from '../components/Chapter.astro'
import Reveal from '../components/Reveal.jsx'
import { ChannelsShot } from '../mockups/shots.jsx'
---

<Chapter id="channels" tone="dark">
  <div class="ch-head">
    <Reveal client:visible>
      <p class="t-eyebrow">Both sides, no bot</p>
      <h2 class="t-h2 ch-h2">No bot in your call.</h2>
    </Reveal>
    <Reveal client:visible delay={0.08}>
      <p class="t-lede ch-lede">
        Prism records your mic and what you hear as separate tracks. It knows who
        said what without guessing, and the other side sees nothing.
      </p>
    </Reveal>
  </div>

  <p class="sr-only">
    Two recording channels, one labelled your microphone and one labelled what you
    hear, feeding a transcript whose lines are already attributed.
  </p>

  <div class="ch-shot">
    <ChannelsShot client:visible />
  </div>

  <Reveal client:visible delay={0.1}>
    <p class="t-caption ch-foot">
      Zoom, Meet, Teams, a phone on speaker, or the room.
    </p>
  </Reveal>
</Chapter>

<style>
  .ch-head { max-width: 1040px; }
  .ch-h2 { margin-top: 18px; }
  .ch-lede { margin-top: 22px; }
  .ch-shot { margin-top: clamp(48px, 6vw, 80px); }
  .ch-foot { margin-top: 28px; text-align: center; }
</style>
