---
import Chapter from '../components/Chapter.astro'
import Reveal from '../components/Reveal.jsx'
import { TasksShot } from '../mockups/shots.jsx'
---

<Chapter id="tasks" tone="light">
  <div class="tk-head">
    <Reveal client:visible>
      <p class="t-eyebrow">Tasks</p>
      <h2 class="t-h2 tk-h2">What you agreed to, pulled out of the conversation.</h2>
    </Reveal>
    <Reveal client:visible delay={0.08}>
      <p class="t-lede tk-lede">
        Action items become tasks with a date and a link back to the note. Send them to
        Microsoft To Do if that is where you live.
      </p>
    </Reveal>
  </div>

  <p class="sr-only">
    A list of tasks lifted from calls, each with the note it came from, the folder it
    was filed in, and a due date.
  </p>

  <div class="tk-shot">
    <TasksShot client:visible />
  </div>
</Chapter>

<style>
  .tk-head { max-width: 1040px; }
  .tk-h2 { margin-top: 18px; }
  .tk-lede { margin-top: 22px; }
  .tk-shot { margin-top: clamp(48px, 6vw, 80px); max-width: 1280px; margin-inline: auto; }
</style>
